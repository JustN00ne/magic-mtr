[17:02:12] [Worker-Main-1/DEBUG] (Mod Menu/Update Checker) {"2da85c071c854223cc30c8e46794391b77e53f28ecdbbde59dc83b3dbbdfc74be9e68da9ed464e7f98b4361033899ba4f681ebff1f35edc2c60e599a59796f1c":{"game_versions":["1.20","1.20.1"],"loaders":["fabric"],"id":"2xQdCMyG","project_id":"9s6osm5g","author_id":"1Hsaf75m","featured":false,"name":"[Fabric 1.20(.1)] v11.1.136","version_number":"11.1.136+fabric","changelog":"","changelog_url":null,"date_published":"2024-09-16T17:13:47.844274Z","downloads":10255431,"version_type":"release","status":"listed","requested_status":null,"files":[{"id":"CSG2lSHr","hashes":{"sha1":"d5fe84a0cc9ed5c7290a76ba570e1f8716afecab","sha512":"2da85c071c854223cc30c8e46794391b77e53f28ecdbbde59dc83b3dbbdfc74be9e68da9ed464e7f98b4361033899ba4f681ebff1f35edc2c60e599a59796f1c"},"url":"https://cdn.modrinth.com/data/9s6osm5g/versions/2xQdCMyG/cloth-config-11.1.136-fabric.jar","filename":"cloth-config-11.1.136-fabric.jar","primary":true,"size":1172214,"file_type":null}],"dependencies":[]},"d3a3173cd3f6d19f5a868562d25a902a3f8936246d8a21613fe57b14497c81b989f094fa899eb6f879ffd8d0768ed354e6d8e6e6c750b4254edef8e9a2b727bc":{"game_versions":["1.20","1.20.1","1.20.2","1.20.3","1.20.4"],"loaders":["fabric"],"id":"lHRktt6S","project_id":"swbUV1cr","author_id":"5x96R9Op","featured":false,"name":"5.3-fabric-1.20","version_number":"5.3-fabric-1.20","changelog":"### Highlights / Notes\nMostly bugfixes.\n\n### Upgrading from 5.2\nJust replace the .jar-file :)  \nOptionally delete your `<webroot>/index.html` to make bluemap update the webapp.\n\n### Changelog since 5.2\n- Changed lowres-tile saving to be even more robust, reducing the probability of lowres-tiles corrupting even if \n  there are temporary issues when trying to save them (e.g. a short db-connection loss)  \n  This also fixes an occasional tile-save error with databases when bluemap is disabling (or reloading).\n- Reloading the webapp (F5) will now automatically trigger a map-refresh (thanks to @MicLieg)\n- Fixed an error reading chunks that are larger than a certain threshold\n- Fixed an NPE when the region-folder of a dimension isn't present for some time\n- Fixed the debug-dump being named `dump.json.gz` but not being actually compressed -> renamed back to `dump.json`\n- Fixed some leftover debug code spawning a random `teststate.json` on cli\n- Fixed an incompatibility with some fabric/forge mods\n- Fixed cli errors when using ctrl+c to stop\n- Fixed exception when a player joins the server on fabric-1.20\n- Fixed spigot version detection\n- Fixed a `core.conf` typo (thanks to @monke8555)\n\n### Full Changelog\nhttps://github.com/BlueMap-Minecraft/BlueMap/releases/tag/v5.3\n","changelog_url":null,"date_published":"2024-07-22T22:36:11.195177Z","downloads":28336,"version_type":"release","status":"listed","requested_status":null,"files":[{"id":"spI7LtDt","hashes":{"sha512":"d3a3173cd3f6d19f5a868562d25a902a3f8936246d8a21613fe57b14497c81b989f094fa899eb6f879ffd8d0768ed354e6d8e6e6c750b4254edef8e9a2b727bc","sha1":"4f4af6f912a89df94a4c5fbddc288ab3d17d05a1"},"url":"https://cdn.modrinth.com/data/swbUV1cr/versions/lHRktt6S/BlueMap-5.3-fabric-1.20.jar","filename":"BlueMap-5.3-fabric-1.20.jar","primary":true,"size":4829808,"file_type":null}],"dependencies":[{"version_id":null,"project_id":"P7dR8mSH","file_name":null,"dependency_type":"required"}]}}
